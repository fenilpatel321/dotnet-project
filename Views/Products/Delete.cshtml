@model Product
@{ ViewData["Title"] = "Delete Product"; }
<div class="page-heading"><div><p class="eyebrow mb-1">REMOVE RECORD</p><h1 class="h2 fw-bold mb-1">Delete product</h1><p class="text-secondary mb-0">Please confirm before removing this item.</p></div><a asp-action="Index" class="btn btn-outline-secondary">← Back to inventory</a></div>
<div class="content-card delete-card">
    <div class="warning-icon">!</div><h2 class="h5 fw-bold">Delete “@Model.Name”?</h2><p class="text-secondary">This action permanently removes this product from the inventory database.</p>
    <div class="delete-summary"><div><span class="detail-label">SKU</span><strong>@Model.SKU</strong></div><div><span class="detail-label">Quantity</span><strong>@Model.Quantity</strong></div><div><span class="detail-label">Category</span><strong>@Model.Category</strong></div></div>
    <form asp-action="Delete" method="post" class="d-flex gap-2 mt-4"><input type="hidden" asp-for="Id" /><button type="submit" class="btn btn-danger">Yes, delete product</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form>
</div>

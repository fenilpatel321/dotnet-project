@model IEnumerable<Product>
@{
    ViewData["Title"] = "Inventory";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}
<div class="page-heading">
    <div><p class="eyebrow mb-1">PRODUCT CATALOG</p><h1 class="h2 fw-bold mb-1">Inventory</h1><p class="text-secondary mb-0">Manage product details and stock quantities.</p></div>
    <a asp-action="Create" class="btn btn-primary btn-lg">＋ Add Product</a>
</div>
<div class="content-card mb-3">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-lg-5"><label class="form-label">Search products</label><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name, SKU or supplier..." /></div>
        <div class="col-lg-3"><label class="form-label">Category</label><select name="category" class="form-select"><option value="">All categories</option>@foreach (var c in categories) { <option value="@c" selected="@(ViewBag.Category as string == c)">@c</option> }</select></div>
        <div class="col-lg-2"><label class="form-label">Stock status</label><select name="stock" class="form-select"><option value="">All stock</option><option value="low" selected="@(ViewBag.Stock as string == "low")">Low stock</option></select></div>
        <div class="col-lg-2 d-flex gap-2"><button class="btn btn-primary flex-grow-1" type="submit">Filter</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div>
    </form>
</div>
<div class="content-card">
    <div class="section-heading"><div><h2 class="h5 fw-bold mb-1">All products</h2><p class="text-secondary small mb-0">@Model.Count() item(s) found</p></div></div>
    @if (!Model.Any())
    {
        <div class="empty-state"><div class="empty-icon">＋</div><h3 class="h6 fw-bold">No products found</h3><p class="text-secondary">Add a product or change your search filters.</p><a asp-action="Create" class="btn btn-primary">Add first product</a></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Product</th><th>SKU</th><th>Category</th><th>Price</th><th>Quantity</th><th>Supplier</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><div class="fw-semibold">@p.Name</div><div class="text-secondary small">Updated @p.UpdatedAt.ToString("dd MMM yyyy")</div></td>
                        <td><span class="sku">@p.SKU</span></td><td>@p.Category</td><td class="fw-semibold">₹@p.Price.ToString("N2")</td>
                        <td><span class="stock-badge @(p.Quantity <= p.ReorderLevel ? "low" : "good")">@p.Quantity in stock</span></td><td>@(string.IsNullOrWhiteSpace(p.Supplier) ? "—" : p.Supplier)</td>
                        <td><div class="d-flex justify-content-end gap-1"><a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-light">View</a><a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Edit</a><a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Delete</a></div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

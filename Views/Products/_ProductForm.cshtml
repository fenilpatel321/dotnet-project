@model Product
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="e.g. Wireless Mouse" /><span asp-validation-for="Name" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="SKU" class="form-label"></label><input asp-for="SKU" class="form-control" placeholder="e.g. ACC-001" /><span asp-validation-for="SKU" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="Category" class="form-label"></label><input asp-for="Category" class="form-control" placeholder="e.g. Accessories" /><span asp-validation-for="Category" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="Supplier" class="form-label"></label><input asp-for="Supplier" class="form-control" placeholder="Supplier or company name" /><span asp-validation-for="Supplier" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="Price" class="form-label"></label><div class="input-group"><span class="input-group-text">₹</span><input asp-for="Price" class="form-control" type="number" min="0.01" step="0.01" /></div><span asp-validation-for="Price" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="Quantity" class="form-label"></label><input asp-for="Quantity" class="form-control" type="number" min="0" /><span asp-validation-for="Quantity" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="ReorderLevel" class="form-label"></label><input asp-for="ReorderLevel" class="form-control" type="number" min="0" /><span asp-validation-for="ReorderLevel" class="text-danger small"></span></div>
</div>
<div class="form-actions mt-4"><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button type="submit" class="btn btn-primary px-4">@ViewData["SubmitLabel"]</button></div>
